{
  "expo": {
    "name": "Finance",
    "slug": "cadence",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cadence",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "com.thenetaji.cadence",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121214",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thenetaji.cadence"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3EF",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 1,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-blank.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach receipt photos to transactions",
          "cameraPermission": "Photograph receipts",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock with Face ID"
        }
      ],
      "expo-localization",
      "@react-native-community/datetimepicker",
      "@studio/config/plugins/with-scene-lifecycle",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Rupee",
            "ios": {
              "light": "./assets/images/icon-rupee.png",
              "dark": "./assets/images/icon-rupee-dark.png",
              "tinted": "./assets/images/icon-rupee-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/images/android-icon-rupee-foreground.png",
              "backgroundColor": "#121214"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
